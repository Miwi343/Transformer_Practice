    {
      "cell_type": "code",
      "source": [
        "from random import random\n",
        "\n",
        "def create_random_equation() -> (str, str):\n",
        "  a = int(random() * 1000)\n",
        "  b = int(random() * 1000)\n",
        "\n",
        "  return equation_to_str(a, b, a+b)\n",
        "\n",
        "def equation_to_str(num1: int, num2: int, answer: int) -> (str, str):\n",
        "  return ( f\"{num1} + {num2} = \", f\"{answer}\" )\n"
      ],
