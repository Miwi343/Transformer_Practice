        "# create a positional encoding matrix (positions x embedding dim)\n",
        "def positional_encoding( max_sequence_length, d_model):\n",
        "  division_term = jnp.exp( jnp.arange(0,d_model) * -(jnp.log(10000.0) / d_model))\n",
        "\n",
        "  # create matrix of (max_seq_len, d_model) without sin/cosine applied\n",
        "  positions = jnp.arange(0, max_sequence_length)[:,jnp.newaxis]\n",
        "  no_transformation = positions * division_term\n",
        "\n",
        "  # transform using sin/cosine and put into encodings\n",
        "  encodings = jnp.zeros((max_sequence_length, d_model))\n",
        "  encodings = encodings.at[:, 0::2].set(jnp.sin(no_transformation[:, 0::2]))\n",
        "  encodings = encodings.at[:, 1::2].set(jnp.cos(no_transformation[:, 1::2]))\n",
        "\n",
        "  return encodings\n",
        ""
