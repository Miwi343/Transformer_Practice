    {
      "cell_type": "code",
      "source": [
        "def build_dataset() -> Tuple[List[List[int]], List[List[int]]]:\n",
        "  problem_dataset = []\n",
        "  answer_dataset = []\n",
        "\n",
        "  # pad to match longest length\n",
        "  longest_tokenized_problem = 0\n",
        "  longest_tokenized_answer = 0\n",
        "\n",
        "  for i in range(10000):\n",
        "    problem_string, answer_string = create_random_equation()\n",
        "    tokenized_problem = tokenize(problem_string)\n",
        "    tokenized_answer = tokenize(answer_string)\n",
        "\n",
        "    longest_tokenized_problem = max(len(tokenized_problem), longest_tokenized_problem)\n",
        "    longest_tokenized_answer = max(len(tokenized_answer), longest_tokenized_answer)\n",
        "    # add the tokenized problem and answer to both datasets\n",
        "    problem_dataset.append(tokenized_problem)\n",
        "    answer_dataset.append(tokenized_answer)\n",
        "\n",
        "  # add padding to make sure all inputs are same length\n",
        "  for i in range(10000):\n",
        "    n = len(problem_dataset[i])\n",
        "    m = len(answer_dataset[i])\n",
        "\n",
        "    if n < longest_tokenized_problem:\n",
        "      padding = [PAD_TOKEN] * (longest_tokenized_problem-n)\n",
        "      problem_dataset[i] = problem_dataset[i] + padding\n",
        "\n",
        "    if m < longest_tokenized_answer:\n",
        "      padding = [PAD_TOKEN] * (longest_tokenized_answer-m)\n",
        "      answer_dataset[i] = answer_dataset[i] + padding\n",
        "\n",
        "  return problem_dataset, answer_dataset"
      ],
