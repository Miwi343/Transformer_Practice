        "\n",
        "token_to_idx = {vocabulary[i]:i for i in range(vocab_size)}\n",
        "idx_to_token = {i:vocabulary[i] for i in range(vocab_size)}\n",
        "\n",
        "print(f\"{token_to_idx}\")\n",
        "print(f\"{idx_to_token}\")"
