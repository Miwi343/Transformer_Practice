      "source": [
        "##Tokenize & Detokenizer\n",
        "**Tokenize**: Takes in a string and convert it one character at a time to tokens.\n",
        "**Detokenize**: Reverse"
      ],
      "metadata": {
        "id": "KGv90MbhrtTW"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def tokenize(string: str) -> List[int]:\n",
        "  token_list = []\n",
        "  for char in string:\n",
        "    if char not in token_to_idx:\n",
        "      raise Exception(\"Invalid expression.\")\n",
        "      return\n",
        "    token_list.append(token_to_idx[char])\n",
        "\n",
        "  token_list.append(EOS_TOKEN)\n",
        "  return token_list\n",
        "\n",
        "def detokenize(idxs: List[int]) -> str:\n",
        "  str_list = []\n",
        "  for idx in idxs:\n",
        "    if idx not in idx_to_token:\n",
        "      raise Exception(\"Invalid expression.\")\n",
        "      return\n",
        "\n",
        "    token = idx_to_token[idx]\n",
        "    if token == '<EOS>':\n",
        "      break\n",
        "    if token == '<PAD>':\n",
        "      continue\n",
        "    elif token == '+' or token == '=':\n",
        "      str_list.append(' ')\n",
        "      str_list.append(token)\n",
        "      str_list.append(' ')\n",
        "    else:\n",
        "      str_list.append(token)\n",
        "\n",
        "  return \"\".join(str_list)\n",
        "\n",
        ""
      ],
      "metadata": {
        "id": "0ZmBVQADrstC"
      },
      "execution_count": 3,
      "outputs": []
    },
